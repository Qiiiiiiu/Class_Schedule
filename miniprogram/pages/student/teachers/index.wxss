.container {
  min-height: 100vh;
  background: var(--bg-color, #0f1419);
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  width: 100%;
}

.bind-code-section {
  background: var(--card-bg-gradient, linear-gradient(145deg, #23293a, #1a1f2e));
  padding: 40rpx 30rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx var(--shadow-color, rgba(0, 0, 0, 0.3));
  border-bottom: 1rpx solid var(--card-border, rgba(255, 255, 255, 0.06));
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary-color, #f1f5f9);
  display: block;
  margin-bottom: 8rpx;
}

.section-desc {
  font-size: 24rpx;
  color: var(--text-hint-color, #64748b);
}

.my-apps-btn {
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(59, 130, 246, 0.14);
  border: 1rpx solid rgba(59, 130, 246, 0.3);
  color: #3b82f6;
  font-size: 24rpx;
  font-weight: 500;
}

.code-input-row {
  display: flex;
  gap: 20rpx;
}

.code-input {
  flex: 1;
  height: 80rpx;
  background: var(--input-bg, rgba(255, 255, 255, 0.05));
  border: 1rpx solid var(--input-border, rgba(255, 255, 255, 0.1));
  border-radius: 40rpx;
  padding: 0 40rpx;
  font-size: 32rpx;
  letter-spacing: 8rpx;
  text-align: center;
  color: var(--text-primary-color, #f1f5f9);
}

.bind-btn {
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: var(--text-secondary-color, #94a3b8);
  background: var(--input-bg, rgba(255, 255, 255, 0.05));
  border: 1rpx solid var(--input-border, rgba(255, 255, 255, 0.1));
  display: flex;
  align-items: center;
  justify-content: center;
}

.bind-btn.active {
  background: linear-gradient(145deg, #3b82f6, #2563eb);
  color: #ffffff;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.4);
}

.bind-btn.disabled {
  opacity: 0.6;
}

.teacher-list {
  width: calc(100% - 60rpx);
  margin: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.teacher-card {
  background: var(--card-bg-gradient, linear-gradient(145deg, #23293a, #1a1f2e));
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx var(--shadow-color, rgba(0, 0, 0, 0.3));
  border: 1rpx solid var(--card-border, rgba(255, 255, 255, 0.06));
}

.teacher-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.teacher-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.teacher-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #3b82f6, #2563eb);
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
}

.teacher-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.teacher-name {
  font-size: 30rpx;
  color: var(--text-primary-color, #f1f5f9);
  font-weight: 500;
}

.teacher-meta {
  font-size: 24rpx;
  color: var(--text-hint-color, #64748b);
}

.teacher-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.teacher-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-approved {
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
}

.expand-arrow {
  font-size: 24rpx;
  color: var(--text-hint-color, #64748b);
}

/* 教师可申请课程折叠区 */
.teacher-courses {
  border-top: 1rpx solid var(--item-border, rgba(255, 255, 255, 0.06));
  padding: 20rpx 30rpx 28rpx;
  background: var(--input-bg, rgba(255, 255, 255, 0.02));
}

.course-apply-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--item-border, rgba(255, 255, 255, 0.05));
}

.course-apply-row:last-child {
  border-bottom: none;
}

.course-apply-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  padding-right: 16rpx;
}

.course-apply-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary-color, #f1f5f9);
}

.course-apply-sub {
  font-size: 22rpx;
  color: var(--text-secondary-color, #94a3b8);
}

.apply-action-btn {
  padding: 0 24rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 29rpx;
  font-size: 24rpx;
  background: linear-gradient(145deg, #3b82f6, #2563eb);
  color: #ffffff;
  margin: 0;
}

.apply-tag {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
}

.apply-tag.enrolled {
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
}

.apply-tag.pending {
  background: rgba(245, 158, 11, 0.15);
  color: #f59e0b;
}

.teacher-courses-empty {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-hint-color, #64748b);
  padding: 16rpx 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  color: var(--text-hint-color, #64748b);
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-hint-color, #64748b);
}
