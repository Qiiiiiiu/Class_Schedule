.container {
  min-height: 100vh;
  background: var(--bg-color, #0f1419);
  padding: 30rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.form-section {
  background: var(--card-bg-solid, #1a1f2e);
  border-radius: 30rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid var(--card-border, rgba(255, 255, 255, 0.06));
  box-shadow: 0 4rpx 16rpx var(--shadow-color, rgba(0, 0, 0, 0.15));
}

.error-section {
  text-align: center;
  padding: 60rpx 40rpx;
}

.error-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary-color, #f1f5f9);
  margin-bottom: 16rpx;
}

.error-desc {
  display: block;
  font-size: 26rpx;
  color: var(--text-secondary-color, #94a3b8);
}

.section-header {
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid var(--item-border, rgba(255, 255, 255, 0.06));
  padding-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary-color, #f1f5f9);
}

.section-desc {
  font-size: 22rpx;
  color: var(--text-hint-color, #64748b);
  margin-left: 10rpx;
}

.section-badge {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.section-badge.student {
  background: rgba(59, 130, 246, 0.15);
  color: #3b82f6;
  border: 1rpx solid rgba(59, 130, 246, 0.3);
}

.section-badge.teacher {
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
  border: 1rpx solid rgba(16, 185, 129, 0.3);
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--item-border, rgba(255, 255, 255, 0.04));
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 28rpx;
  color: var(--text-secondary-color, #94a3b8);
  flex-shrink: 0;
}

.detail-value {
  font-size: 28rpx;
  color: var(--text-primary-color, #f1f5f9);
  font-weight: 500;
  text-align: right;
  flex: 1;
  margin-left: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.label {
  width: 180rpx;
  font-size: 28rpx;
  color: var(--text-secondary-color, #94a3b8);
}

.content-wrap {
  flex: 1;
}

.input, .picker-value {
  background: var(--input-bg, #0f1419);
  border: 1rpx solid var(--input-border, rgba(255, 255, 255, 0.1));
  border-radius: 8rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary-color, #f1f5f9);
  min-height: 80rpx;
  box-sizing: border-box;
}

.picker-value {
  display: flex;
  align-items: center;
}

.time-picker {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.time-picker picker {
  flex: 1;
}

.time-separator {
  color: var(--text-hint-color, #64748b);
  font-size: 28rpx;
}

.select-calendar-view {
  background: var(--input-bg, #0f1419);
  border-radius: 12rpx;
  border: 1rpx solid var(--input-border, rgba(255, 255, 255, 0.08));
  padding: 20rpx;
  box-sizing: border-box;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.calendar-nav {
  padding: 0 20rpx;
}

.nav-btn {
  font-size: 48rpx;
  color: #3b82f6;
  font-weight: bold;
}

.calendar-title {
  font-size: 30rpx;
  color: var(--text-primary-color, #f1f5f9);
  font-weight: 600;
}

.calendar-weekdays {
  display: flex;
  width: 100%;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid var(--item-border, rgba(255, 255, 255, 0.06));
  padding-bottom: 12rpx;
}

.calendar-weekday-item {
  flex: 1;
  text-align: center;
}

.weekday {
  font-size: 24rpx;
  color: var(--text-hint-color, #64748b);
}

.calendar-grid {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.calendar-row {
  display: flex;
  width: 100%;
  border-bottom: 1rpx solid var(--item-border, rgba(255, 255, 255, 0.04));
}

.calendar-row:last-child {
  border-bottom: none;
}

.select-calendar-day-cell {
  flex: 1;
  height: 90rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  box-sizing: border-box;
  border-right: 1rpx solid var(--item-border, rgba(255, 255, 255, 0.04));
}

.select-calendar-day-cell:last-child {
  border-right: none;
}

.day-number {
  font-size: 28rpx;
  color: var(--text-primary-color, #f1f5f9);
}

.select-calendar-day-cell.other-month .day-number {
  color: var(--text-hint-color, #475569);
  opacity: 0.5;
}

.select-calendar-day-cell.today .day-number {
  color: #3b82f6;
  font-weight: bold;
}

.select-calendar-day-cell.selected {
  background: rgba(59, 130, 246, 0.2);
  border: 2rpx solid #3b82f6;
  border-radius: 12rpx;
}

.select-calendar-day-cell.selected .day-number {
  color: #3b82f6;
  font-weight: bold;
}

.select-calendar-day-cell.has-schedule {
  background: rgba(59, 130, 246, 0.08);
  border-radius: 8rpx;
}

.select-calendar-day-cell.has-schedule .day-number {
  color: #3b82f6;
  font-weight: bold;
}

.schedule-dot {
  width: 8rpx;
  height: 8rpx;
  background: #3b82f6;
  border-radius: 50%;
  position: absolute;
  bottom: 8rpx;
}

.actions-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 40rpx;
  width: 100%;
}

.action-btn {
  font-size: 30rpx !important;
  font-weight: bold !important;
  height: 90rpx;
  width: 100% !important;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx !important;
}

.edit-btn {
  background: linear-gradient(145deg, #3b82f6, #2563eb) !important;
  color: #ffffff !important;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.3);
}

.delete-btn {
  background: var(--logout-bg, rgba(239, 68, 68, 0.15)) !important;
  color: var(--logout-color, #ef4444) !important;
  border: 1rpx solid var(--logout-border, rgba(239, 68, 68, 0.3)) !important;
}

.save-btn {
  background: linear-gradient(145deg, #10b981, #059669) !important;
  color: #ffffff !important;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.3);
}

.cancel-btn {
  background: var(--modal-btn-cancel-bg, rgba(255, 255, 255, 0.08)) !important;
  color: var(--modal-btn-cancel-text, #94a3b8) !important;
  border: 1rpx solid var(--input-border, rgba(255, 255, 255, 0.1)) !important;
}
