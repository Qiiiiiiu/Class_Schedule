<view class="container {{theme}}">
  <view class="user-card">
    <image class="avatar" src="{{userInfo.avatar || '/images/icons/avatar.png'}}" mode="aspectFill"></image>
    <view class="info">
      <text class="name">{{userInfo.name}}</text>
      <text class="role-badge role-{{userInfo.role}}">{{userInfo.role === 'teacher' ? '教师' : '学生'}}</text>
    </view>
  </view>

  <view class="info-list">
    <view class="info-item clickable" bindtap="showEditNameModal">
      <text class="info-label">姓名</text>
      <view class="info-value-wrapper">
        <text class="info-value">{{userInfo.name}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="info-item">
      <text class="info-label">手机号</text>
      <text class="info-value">{{userInfo.phone || '未填写'}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">角色</text>
      <text class="info-value">{{userInfo.role === 'teacher' ? '教师' : '学生'}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">注册时间</text>
      <text class="info-value">{{createTime}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">深色模式</text>
      <switch checked="{{theme === 'dark'}}" color="#3b82f6" bindchange="onThemeChange" />
    </view>
  </view>

  <button class="logout-btn" bindtap="onLogout">退出登录</button>

  <!-- 修改姓名弹窗 -->
  <view class="modal-mask" wx:if="{{showEditModal}}" bindtap="hideEditModal" catchtouchmove="preventTouchMove"></view>
  <view class="modal-dialog" wx:if="{{showEditModal}}">
    <view class="modal-title">修改姓名</view>
    <view class="modal-content">
      <input class="modal-input" placeholder="请输入新姓名" value="{{newName}}" bindinput="onNewNameInput" maxlength="15" focus="{{showEditModal}}" />
    </view>
    <view class="modal-footer">
      <button class="modal-btn cancel" bindtap="hideEditModal">取消</button>
      <button class="modal-btn confirm" bindtap="onSaveName">确定</button>
    </view>
  </view>
</view>