page {
  width: 100%;
  overflow-x: hidden !important;
}

.page-container {
  min-height: 100vh;
  background: var(--bg-color, #0f1419);
  padding: 20rpx;
  padding-bottom: 160rpx;
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
  box-sizing: border-box;
}

.reminder-section {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.reminder-btn {
  background: linear-gradient(145deg, #10b981, #059669);
  color: #fff;
  border: none;
  border-radius: 28rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
}

.info-icon {
  font-size: 32rpx;
  cursor: pointer;
}

.course-list {
  margin: 0;
  padding: 0;
}

.course-item {
  background: var(--card-bg-solid, #23293a);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  width: 100%;
  max-width: 710rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--card-border, rgba(255, 255, 255, 0.06));
  box-shadow: 0 4rpx 12rpx var(--shadow-color, rgba(0, 0, 0, 0.2));
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  position: relative;
}

.course-header {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding-right: 110rpx;
  flex-basis: 100%;
  box-sizing: border-box;
}

.class-type-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.class-type-badge.type-one_on_one {
  background: rgba(59, 130, 246, 0.16);
  color: #3b82f6;
  border: 1rpx solid rgba(59, 130, 246, 0.3);
}

.class-type-badge.type-group {
  background: rgba(139, 92, 246, 0.16);
  color: #8b5cf6;
  border: 1rpx solid rgba(139, 92, 246, 0.3);
}

.billing-badge {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(16, 185, 129, 0.12);
  color: #10b981;
  flex-shrink: 0;
}

.info-icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.course-name {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-primary-color, #f1f5f9);
}

.course-status {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.status-available {
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
}

.status-unavailable {
  background: rgba(255, 255, 255, 0.05);
  color: #64748b;
}

.course-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
  flex-basis: 100%;
}

.info-item {
  font-size: 24rpx;
  color: var(--text-secondary-color, #94a3b8);
}

.course-amount {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
  flex-basis: 100%;
}

.amount-item {
  font-size: 24rpx;
  color: #3b82f6;
}

.course-actions {
  display: flex;
  gap: 10rpx;
  width: 100%;
  box-sizing: border-box;
}

.course-actions button {
  flex: 1;
  height: 56rpx;
  background: var(--input-bg, rgba(255, 255, 255, 0.05));
  border: 1rpx solid var(--input-border, rgba(255, 255, 255, 0.1));
  border-radius: 28rpx;
  font-size: 22rpx;
  color: var(--text-secondary-color, #94a3b8);
  padding: 0;
  margin: 0;
  width: calc(33.333% - 7rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.course-actions button::after {
  border: none;
}

.course-actions button:nth-child(2) {
  background: var(--input-bg, rgba(255, 255, 255, 0.05));
}

.course-actions button:nth-child(3) {
  color: var(--logout-color, #ef4444);
  background: var(--logout-bg, rgba(239, 68, 68, 0.12));
  border-color: var(--logout-border, rgba(239, 68, 68, 0.2));
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  color: #64748b;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 30rpx;
}

.add-btn {
  width: 200rpx;
  height: 72rpx;
  background: linear-gradient(145deg, #3b82f6, #2563eb);
  border: none;
  border-radius: 36rpx;
  color: #ffffff;
  font-size: 26rpx;
}

.add-floating-btn {
  position: fixed;
  right: 20rpx;
  bottom: 130rpx;
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(145deg, #3b82f6, #2563eb);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.add-floating-btn text {
  font-size: 56rpx;
  color: #ffffff;
  font-weight: 300;
}

/* 顶部 Tab 栏 */
.course-tabs {
  display: flex;
  background: var(--card-bg-solid, #1a1f2e);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--card-border, rgba(255, 255, 255, 0.06));
  overflow: hidden;
}

.course-tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary-color, #94a3b8);
  position: relative;
}

.course-tab-item.active {
  color: #3b82f6;
  font-weight: bold;
}

.course-tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 64rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #3b82f6, #06b6d4);
}

.tab-badge {
  background: #ef4444;
  color: #ffffff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  line-height: 1.4;
}

/* 选课申请卡片 */
.application-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.application-card {
  background: var(--card-bg-solid, #23293a);
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid var(--card-border, rgba(255, 255, 255, 0.06));
  box-shadow: 0 4rpx 12rpx var(--shadow-color, rgba(0, 0, 0, 0.2));
}

.app-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.app-course-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary-color, #f1f5f9);
}

.app-pending-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(245, 158, 11, 0.15);
  color: #f59e0b;
}

.app-card-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.app-meta-line {
  font-size: 24rpx;
  color: var(--text-secondary-color, #94a3b8);
}

.app-card-actions {
  display: flex;
  gap: 16rpx;
}

.app-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  margin: 0;
  padding: 0;
}

.app-btn.approve {
  background: linear-gradient(145deg, #10b981, #059669);
  color: #ffffff;
}

.app-btn.reject {
  background: var(--logout-bg, rgba(239, 68, 68, 0.12));
  color: var(--logout-color, #ef4444);
  border: 1rpx solid var(--logout-border, rgba(239, 68, 68, 0.2));
}
