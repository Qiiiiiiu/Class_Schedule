.container {
  width: 100%;
  min-height: 100vh;
  background: var(--bg-color, #0f1419);
  padding: 24rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  align-items: stretch;
  gap: 24rpx;
}

.student-banner {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 28rpx;
  border-radius: 20rpx;
  background: var(--card-bg-gradient, linear-gradient(145deg, #23293a, #1a1f2e));
  border: 1rpx solid var(--card-border, rgba(255, 255, 255, 0.06));
}

.banner-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.banner-label {
  font-size: 22rpx;
  color: #3b82f6;
  background: rgba(59, 130, 246, 0.14);
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.banner-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary-color, #f1f5f9);
}

.banner-stat {
  font-size: 24rpx;
  color: var(--text-secondary-color, #94a3b8);
}

.card-section {
  width: 100%;
  box-sizing: border-box;
  background: var(--card-bg-gradient, linear-gradient(145deg, #23293a, #1a1f2e));
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  box-shadow: 0 8rpx 28rpx var(--shadow-color, rgba(0, 0, 0, 0.25));
  border: 1rpx solid var(--card-border, rgba(255, 255, 255, 0.06));
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-bar {
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #3b82f6, #06b6d4);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary-color, #f1f5f9);
}

.section-count {
  font-size: 22rpx;
  font-weight: 600;
  color: #3b82f6;
  background: rgba(59, 130, 246, 0.14);
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
}

.cancel-edit-btn {
  font-size: 24rpx;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.14);
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.summary-chip {
  font-size: 22rpx;
  color: var(--text-secondary-color, #94a3b8);
  background: var(--input-bg, rgba(255, 255, 255, 0.05));
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 表单 */
.form-group {
  margin-bottom: 22rpx;
}

.form-label {
  display: block;
  font-size: 25rpx;
  color: var(--text-secondary-color, #94a3b8);
  margin-bottom: 10rpx;
  font-weight: 500;
}

.required {
  color: #ef4444;
}

.picker-box {
  width: 100%;
  height: 84rpx;
  background: var(--input-bg, rgba(255, 255, 255, 0.05));
  border: 1rpx solid var(--input-border, rgba(255, 255, 255, 0.1));
  border-radius: 14rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-val {
  font-size: 28rpx;
  color: var(--text-primary-color, #f1f5f9);
  font-weight: 500;
}

.picker-val.placeholder {
  color: var(--text-hint-color, #64748b);
  font-weight: 400;
}

.picker-arrow {
  font-size: 24rpx;
  color: #3b82f6;
}

.form-input {
  width: 100%;
  height: 84rpx;
  background: var(--input-bg, rgba(255, 255, 255, 0.05));
  border: 1rpx solid var(--input-border, rgba(255, 255, 255, 0.1));
  border-radius: 14rpx;
  padding: 0 24rpx;
  color: var(--text-primary-color, #f1f5f9);
  font-size: 28rpx;
  box-sizing: border-box;
}

.input-placeholder {
  color: var(--text-hint-color, #64748b);
}

.submit-btn {
  width: 100% !important;
  min-height: 0 !important;
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 43rpx;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
  margin-top: 12rpx;
  box-shadow: 0 6rpx 20rpx rgba(59, 130, 246, 0.3);
}

.btn-hover {
  opacity: 0.88;
  transform: scale(0.99);
}

/* 历史成绩列表 */
.score-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.score-item {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: var(--input-bg, rgba(255, 255, 255, 0.04));
  border: 1rpx solid var(--item-border, rgba(255, 255, 255, 0.06));
}

.score-item.editing {
  border-color: rgba(59, 130, 246, 0.55);
  background: rgba(59, 130, 246, 0.08);
}

.score-badge {
  min-width: 108rpx;
  height: 84rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  border-radius: 14rpx;
  background: rgba(59, 130, 246, 0.14);
  border: 1rpx solid rgba(59, 130, 246, 0.28);
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4rpx;
  flex-shrink: 0;
  line-height: 84rpx;
}

.score-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #3b82f6;
}

.score-unit {
  font-size: 20rpx;
  color: #3b82f6;
}

.score-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.score-exam {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary-color, #f1f5f9);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.score-date {
  font-size: 22rpx;
  color: var(--text-secondary-color, #94a3b8);
}

.score-ops {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.op-chip {
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.op-chip.edit {
  background: rgba(59, 130, 246, 0.14);
  color: #3b82f6;
  border: 1rpx solid rgba(59, 130, 246, 0.28);
}

.op-chip.danger {
  background: var(--logout-bg, rgba(239, 68, 68, 0.12));
  color: var(--logout-color, #ef4444);
  border: 1rpx solid var(--logout-border, rgba(239, 68, 68, 0.22));
}

.op-hover {
  opacity: 0.72;
}

.empty-block {
  padding: 40rpx 20rpx;
  text-align: center;
  background: var(--input-bg, rgba(255, 255, 255, 0.02));
  border-radius: 14rpx;
  border: 1rpx dashed var(--item-border, rgba(255, 255, 255, 0.08));
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-hint-color, #64748b);
}
