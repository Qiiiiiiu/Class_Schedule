.container {
  min-height: 100vh;
  background: #0f1419;
  padding: 30rpx;
  padding-bottom: 180rpx;
}

.stats-header {
  background: linear-gradient(145deg, #1e2536, #141724);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.action-btns {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.add-btn {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  border: none;
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  box-shadow: 0 6rpx 16rpx rgba(59, 130, 246, 0.3);
  margin: 0;
  width: auto !important;
  min-height: 0 !important;
  transition: all 0.2s ease;
}

.add-btn.secondary {
  background: rgba(255, 255, 255, 0.06);
  color: #e2e8f0;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.stat-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
  text-shadow: 0 2rpx 10rpx rgba(59, 130, 246, 0.2);
}

.stat-label {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 500;
}

/* ===== 验证码区 ===== */
.verify-code-section {
  background: linear-gradient(145deg, #1e2536, #141724);
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(59, 130, 246, 0.15);
}

.code-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.code-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #f1f5f9;
}

.code-expire {
  font-size: 24rpx;
  color: #94a3b8;
}

.code-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.code-value {
  font-size: 64rpx;
  font-weight: 700;
  color: #60a5fa;
  letter-spacing: 10rpx;
  margin-bottom: 16rpx;
  text-shadow: 0 0 16rpx rgba(96, 165, 250, 0.3);
}

.code-hint {
  font-size: 24rpx;
  color: #94a3b8;
}

/* ===== 搜索 ===== */
.filter-bar {
  margin-bottom: 30rpx;
}

.search-box {
  background: rgba(255, 255, 255, 0.04);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 40rpx;
  padding: 16rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: all 0.25s ease;
}

.search-icon-left {
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #f1f5f9;
}

.search-icon {
  font-size: 28rpx;
  color: #64748b;
  padding: 8rpx;
}

/* ===== 学生列表 ===== */
.student-list {
  background: linear-gradient(145deg, #1e2536, #141724);
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.student-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.student-item:active {
  background: rgba(255, 255, 255, 0.02);
}

.student-item:last-child {
  border-bottom: none;
}

.student-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.student-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.25);
}

.info-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.student-name {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: 600;
}

.student-meta {
  font-size: 24rpx;
  color: #94a3b8;
}

/* ===== 状态标签 ===== */
.student-status {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.status-approved {
  background: rgba(16, 185, 129, 0.12);
  color: #34d399;
  border: 1rpx solid rgba(16, 185, 129, 0.2);
}

.status-pending {
  background: rgba(245, 158, 11, 0.12);
  color: #fbbf24;
  border: 1rpx solid rgba(245, 158, 11, 0.2);
}

.status-rejected {
  background: rgba(239, 68, 68, 0.12);
  color: #f87171;
  border: 1rpx solid rgba(239, 68, 68, 0.2);
}

.status-unbound {
  background: rgba(255, 255, 255, 0.06);
  color: #94a3b8;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.student-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.bind-btn {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  border: none;
  border-radius: 30rpx;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.3);
  margin: 0;
  width: auto !important;
  min-height: 0 !important;
  line-height: 1.4;
}

.merge-btn {
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #ffffff;
  border: none;
  border-radius: 30rpx;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.3);
  margin: 0;
  width: auto !important;
  min-height: 0 !important;
  line-height: 1.4;
}

.delete-btn {
  background: rgba(239, 68, 68, 0.12);
  color: #f87171;
  border: 1rpx solid rgba(239, 68, 68, 0.25);
  border-radius: 30rpx;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  font-weight: 500;
  margin: 0;
  width: auto !important;
  min-height: 0 !important;
  line-height: 1.4;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  color: #64748b;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #64748b;
}

/* ===== 弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 20, 25, 0.75);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 680rpx;
  background: linear-gradient(145deg, #202638, #151824);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.modal-content.detail-content {
  max-height: 80vh;
  overflow-y: auto;
}

.modal-content.add-content {
  max-height: 80vh;
  overflow-y: auto;
}

.modal-content.merge-content {
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #f1f5f9;
}

.modal-close {
  font-size: 36rpx;
  color: #64748b;
  padding: 10rpx;
}

.modal-body {
  padding: 30rpx;
  max-height: 50vh;
  overflow-y: auto;
}

/* ===== 合并信息 ===== */
.merge-info {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: rgba(245, 158, 11, 0.15);
  border-radius: 10rpx;
  margin-bottom: 30rpx;
}

.merge-label {
  font-size: 26rpx;
  color: #f59e0b;
  margin-right: 12rpx;
}

.merge-value {
  font-size: 28rpx;
  color: #f1f5f9;
  font-weight: 500;
}

/* ===== 表单 ===== */
.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #94a3b8;
  margin-bottom: 16rpx;
  display: block;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 32rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #f1f5f9;
  line-height: 88rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  padding: 28rpx 32rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #f1f5f9;
  min-height: 120rpx;
  box-sizing: border-box;
}

.form-value {
  font-size: 28rpx;
  color: #f1f5f9;
  line-height: 88rpx;
}

.target-student-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.target-student-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  transition: all 0.2s;
}

.target-student-item:last-child {
  margin-bottom: 0;
}

.target-student-item.selected {
  background: rgba(59, 130, 246, 0.15);
  border-color: rgba(59, 130, 246, 0.3);
}

.target-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #3b82f6, #2563eb);
  margin-right: 20rpx;
}

.target-name {
  flex: 1;
  font-size: 28rpx;
  color: #f1f5f9;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(145deg, #3b82f6, #2563eb);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(59, 130, 246, 0.4);
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.modal-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  margin: 0;
  width: auto !important;
  min-height: 0 !important;
}

.cancel-btn {
  background: rgba(255, 255, 255, 0.05);
  color: #94a3b8;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.confirm-btn {
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(59, 130, 246, 0.35);
  border: none;
}

.confirm-btn[disabled] {
  background: #334155;
  color: #64748b;
  box-shadow: none;
}

/* ===== 动效交互 hover-class ===== */
.btn-hover {
  transform: scale(0.96);
  opacity: 0.85;
}

.text-hover {
  opacity: 0.6;
}
