<view class="container {{theme}}">
  <view class="header">
    <image wx:if="{{userInfo.avatar}}" class="avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
    <view wx:else class="avatar">
      <text class="avatar-emoji">{{greetingEmoji}}</text>
    </view>
    <view class="welcome">
      <text class="title">{{greeting}}，{{userInfo.name}}</text>
      <text class="subtitle">欢迎使用课程管理系统</text>
    </view>
  </view>

  <view class="calendar-section">
    <view class="calendar-header">
      <view class="calendar-nav" bindtap="prevMonth">
        <text class="nav-btn">‹</text>
      </view>
      <text class="calendar-title">{{calendarTitle}}</text>
      <view class="calendar-nav" bindtap="nextMonth">
        <text class="nav-btn">›</text>
      </view>
    </view>
    <view class="calendar-weekdays">
      <view class="weekday-item" wx:for="{{weeklyDays}}" wx:key="index">
        <text class="weekday">{{item}}</text>
      </view>
    </view>
    <view class="calendar-grid">
      <view class="calendar-day {{item.empty ? 'empty' : ''}}" wx:for="{{calendar}}" wx:key="index"
        style="background: {{item.empty ? 'transparent' : item.bgColor}}" bindtap="onCalendarDayTap"
        data-date="{{item.fullDate}}">
        <text wx:if="{{!item.empty}}" class="day-num {{item.isToday ? 'today' : ''}}"
          style="color: {{item.isToday ? '' : item.textColor}}">{{item.date}}</text>
        <text wx:if="{{!item.empty && item.count > 0}}" class="day-count"
          style="color: {{item.isToday ? 'rgba(0, 0, 0, 0.7)' : item.textColor}}">{{item.count}}节</text>
      </view>
    </view>
    <view class="calendar-hint">
      <text class="hint-icon">💡</text>
      <text class="hint-text">提示：点击具体日期可跳转到周课程</text>
    </view>
  </view>

  <!-- 核心指标栏 -->
  <view class="stats-section">
    <text class="section-title">核心数据</text>
    <view class="stats-grid">
      <view class="stat-card">
        <view class="stat-icon-wrapper blue">
          <text class="stat-icon-emoji">👥</text>
        </view>
        <view class="stat-info">
          <text class="stat-value">{{stats.studentCount || 0}}</text>
          <text class="stat-label">总学生数</text>
        </view>
      </view>
      <view class="stat-card">
        <view class="stat-icon-wrapper green">
          <text class="stat-icon-emoji">📚</text>
        </view>
        <view class="stat-info">
          <text class="stat-value">{{stats.courseCount || 0}}</text>
          <text class="stat-label">总课程数</text>
        </view>
      </view>
      <view class="stat-card">
        <view class="stat-icon-wrapper orange">
          <text class="stat-icon-emoji">🔔</text>
        </view>
        <view class="stat-info">
          <text class="stat-value">{{(stats.pendingBindings || 0) + (stats.pendingApplications || 0)}}</text>
          <text class="stat-label">待处理数</text>
        </view>
      </view>
      <view class="stat-card placeholder">
        <view class="stat-icon-wrapper gray">
          <text class="stat-icon-emoji">➕</text>
        </view>
        <view class="stat-info">
          <text class="stat-value placeholder-val">--</text>
          <text class="stat-label">规划指标中</text>
        </view>
      </view>
    </view>
  </view>

  <view class="income-section">
    <view class="income-main">
      <view class="income-left">
        <view class="income-item">
          <text class="income-label">本月收入</text>
          <text class="income-value">¥{{showAmount ? monthlyIncome : '****'}}</text>
        </view>
        <view class="income-item">
          <text class="income-label">时薪</text>
          <text class="income-value">¥{{showAmount ? hourlyRate : '****'}}/h</text>
        </view>
      </view>
      <view class="income-right">
        <image class="eye-icon" src="{{showAmount ? '/images/icons/eye-line.svg' : '/images/icons/eye-off-line.svg'}}"
          bindtap="toggleAmount" mode="aspectFit"></image>
      </view>
    </view>
    <view class="income-footer">
      <text class="total-hours">本月授课时长: {{totalHours}}小时</text>
    </view>
  </view>

  <view class="pending-list" wx:if="{{recentPending.length > 0}}">
    <text class="section-title">待处理事项</text>
    <view class="pending-item" wx:for="{{recentPending}}" wx:key="index" bindtap="onPendingTap" data-item="{{item}}">
      <view class="pending-left">
        <text class="pending-type">{{item.type === 'binding' ? '绑定申请' : '课程预约'}}</text>
        <text class="pending-name">{{item.name}}</text>
      </view>
      <text class="pending-arrow">›</text>
    </view>
  </view>
</view>