.container {
  min-height: 100vh;
  background: var(--bg-color, #0f1419);
  padding: 30rpx;
  padding-top: 0;
  padding-bottom: 180rpx;
  transition: background-color 0.3s ease;
}

.header {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 60rpx 30rpx 40rpx;
  gap: 28rpx;
  width: 105%;
  box-sizing: border-box;
}

.welcome {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-primary-color, #f1f5f9);
  transition: color 0.3s ease;
}

.subtitle {
  font-size: 26rpx;
  color: var(--text-secondary-color, #94a3b8);
  transition: color 0.3s ease;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #3b82f6, #2563eb);
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.avatar-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

/* ===== 日历 ===== */
.calendar-section {
  width: calc(100% - 60rpx);
  max-width: 680rpx;
  background: var(--card-bg-gradient, linear-gradient(145deg, #23293a, #1a1f2e));
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 0 auto 30rpx;
  box-shadow: 0 8rpx 32rpx var(--shadow-color, rgba(0, 0, 0, 0.3)), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--card-border, rgba(255, 255, 255, 0.06));
  transition: all 0.3s ease;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.calendar-nav {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--calendar-nav-bg, rgba(255, 255, 255, 0.06));
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx var(--shadow-color, rgba(0, 0, 0, 0.2));
  transition: all 0.3s ease;
}

.calendar-nav:active {
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
  background: rgba(255, 255, 255, 0.04);
}

.nav-btn {
  font-size: 40rpx;
  color: var(--text-secondary-color, #94a3b8);
  font-weight: bold;
  line-height: 1;
  transition: color 0.3s ease;
}

.calendar-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary-color, #f1f5f9);
  transition: color 0.3s ease;
}

.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 4rpx;
  margin-bottom: 12rpx;
  padding: 0;
}

.weekday-item {
  text-align: center;
  padding: 12rpx 4rpx;
  border-radius: 8rpx;
  background: rgba(59, 130, 246, 0.1) !important;
  color: var(--text-secondary-color, #94a3b8) !important;
  box-shadow: none !important;
  border: 1rpx solid rgba(59, 130, 246, 0.2) !important;
  box-sizing: border-box;
}

.weekday-item:first-child,
.weekday-item:last-child {
  background: rgba(239, 68, 68, 0.12) !important;
  border-color: rgba(239, 68, 68, 0.2) !important;
}

.weekday {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary-color, #94a3b8);
  transition: color 0.3s ease;
}

.weekday-item:first-child .weekday,
.weekday-item:last-child .weekday {
  color: #fca5a5;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
}

.calendar-day {
  aspect-ratio: 1;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  box-sizing: border-box;
  border: 1rpx solid transparent;
}

.calendar-day.empty {
  background: transparent !important;
  border: none !important;
}

.day-num {
  font-size: 26rpx;
  color: var(--text-primary-color, rgba(255, 255, 255, 0.8));
  transition: color 0.3s ease;
}

.day-num.today {
  color: var(--bg-color, #0f1419);
  background: var(--text-primary-color, #f1f5f9);
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
}

.day-count {
  font-size: 18rpx;
  color: inherit;
}

/* ===== 收入统计卡片 ===== */
.income-section {
  width: calc(100% - 60rpx);
  max-width: 680rpx;
  background: var(--card-bg-gradient, linear-gradient(145deg, #23293a, #1a1f2e));
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 0 auto 30rpx;
  box-shadow: 0 8rpx 32rpx var(--shadow-color, rgba(0, 0, 0, 0.3)), inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--card-border, rgba(255, 255, 255, 0.06));
  transition: all 0.3s ease;
}

.income-main {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 80rpx;
}

.income-left {
  display: flex;
  gap: 80rpx;
}

.income-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.income-label {
  font-size: 24rpx;
  color: var(--text-hint-color, #64748b);
  transition: color 0.3s ease;
}

.income-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #3b82f6;
  min-width: 200rpx;
  text-align: center;
}

.income-right {
  display: flex;
  align-items: center;
}

.eye-icon {
  width: 44rpx;
  height: 44rpx;
  color: var(--text-hint-color, #64748b);
  padding: 10rpx;
  transition: color 0.3s ease;
}

.eye-icon.active {
  color: #3b82f6;
}

.income-footer {
  padding-top: 20rpx;
  margin-top: 16rpx;
  border-top: 1rpx dashed var(--divider-color, rgba(255, 255, 255, 0.1));
  text-align: center;
  transition: border-color 0.3s ease;
}

.total-hours {
  font-size: 24rpx;
  color: var(--text-hint-color, #64748b);
  transition: color 0.3s ease;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary-color, #f1f5f9);
  display: block;
  margin-bottom: 24rpx;
  transition: color 0.3s ease;
}

/* ===== 待处理列表 ===== */
.pending-list {
  width: calc(100% - 60rpx);
  max-width: 680rpx;
  margin: 50rpx auto 0;
  padding: 0;
}

.pending-item {
  background: var(--card-bg-gradient, linear-gradient(145deg, #23293a, #1a1f2e));
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx var(--shadow-color, rgba(0, 0, 0, 0.25));
  border: 1rpx solid var(--card-border, rgba(255, 255, 255, 0.06));
  transition: all 0.3s ease;
}

.pending-item:active {
  opacity: 0.8;
}

.pending-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.pending-type {
  font-size: 24rpx;
  color: var(--text-hint-color, #64748b);
  transition: color 0.3s ease;
}

.pending-name {
  font-size: 28rpx;
  color: var(--text-primary-color, #f1f5f9);
  font-weight: 500;
  transition: color 0.3s ease;
}

.pending-arrow {
  font-size: 40rpx;
  color: var(--text-hint-color, #64748b);
  transition: color 0.3s ease;
}

/* ===== 日历温馨提示 ===== */
.calendar-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 12rpx 20rpx;
  background: rgba(59, 130, 246, 0.05);
  border-radius: 12rpx;
  gap: 8rpx;
}

.hint-icon {
  font-size: 24rpx;
}

.hint-text {
  font-size: 22rpx;
  color: var(--text-hint-color, #64748b);
  letter-spacing: 0.5rpx;
}

/* ===== 核心数据栏 ===== */
.stats-section {
  width: calc(100% - 60rpx);
  max-width: 680rpx;
  margin: 0 auto 30rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.stat-card {
  background: var(--card-bg-gradient, linear-gradient(145deg, #23293a, #1a1f2e));
  border: 1rpx solid var(--card-border, rgba(255, 255, 255, 0.06));
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 8rpx 24rpx var(--shadow-color, rgba(0, 0, 0, 0.2));
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.stat-card:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.stat-icon-wrapper {
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.stat-icon-wrapper.blue {
  background: rgba(59, 130, 246, 0.12);
  border: 1rpx solid rgba(59, 130, 246, 0.2);
}

.stat-icon-wrapper.green {
  background: rgba(16, 185, 129, 0.12);
  border: 1rpx solid rgba(16, 185, 129, 0.2);
}

.stat-icon-wrapper.orange {
  background: rgba(245, 158, 11, 0.12);
  border: 1rpx solid rgba(245, 158, 11, 0.2);
}

.stat-icon-wrapper.gray {
  background: rgba(148, 163, 184, 0.08);
  border: 1rpx dashed rgba(148, 163, 184, 0.2);
}

.stat-icon-emoji {
  font-size: 32rpx;
  line-height: 1;
}

.stat-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary-color, #f1f5f9);
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary-color, #94a3b8);
}

/* 规划中卡片特殊样式 */
.stat-card.placeholder {
  border-style: dashed;
  background: transparent;
  box-shadow: none;
}

.stat-card.placeholder .placeholder-val {
  color: var(--text-hint-color, #64748b);
  font-style: italic;
}

.stat-card.placeholder .stat-label {
  color: var(--text-hint-color, #64748b);
}